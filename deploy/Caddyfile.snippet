# Archivo a copiar como `sites/presupuestos.caddy` en el directorio de Caddy del servidor
# (en el VPS, el Caddy vive en el compose de Agendia: /opt/atajolab/apps/agendia/deploy/sites/
# y el Caddyfile principal ya hace `import sites/*.caddy`). No reemplaza ni reinicia otros sitios:
# basta con recargar Caddy (`docker exec <caddy> caddy reload --config /etc/caddy/Caddyfile`).
# Requisito: `presupuestos-app` debe estar en la red `agendia-edge` (PROXY_NETWORK).
presupuestos.atajolab.dev {
	encode zstd gzip
	reverse_proxy presupuestos-app:3000 {
		health_uri /api/health
		health_interval 30s
	}
	log {
		output stdout
		format console
	}
}
