# Copiar a `.env` en el servidor (permisos 600). NUNCA versionar el archivo real.

TAG=latest
PROXY_NETWORK=agendia-edge

# Base de datos. Si se usa el servicio `db` incluido (perfil own-db):
POSTGRES_USER=presupuestos
POSTGRES_PASSWORD=
POSTGRES_DB=presupuestos
DATABASE_URL=postgresql://presupuestos:CAMBIAR@db:5432/presupuestos?schema=public

APP_URL=https://presupuestos.atajolab.dev
AUTH_SECRET=
AUTH_TRUST_HOST=true

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

RESEND_API_KEY=
EMAIL_FROM="AtajoLab Presupuestos <presupuestos@atajolab.dev>"
# Nombre exacto del contenedor de la app (compose usa presupuestos-app)
CONTAINER_NAME=presupuestos-app
COMPOSE_PROFILES=own-db

CRON_SECRET=

# Contacto comercial para plantillas personalizadas (opcional hasta tener el número).
# Sin ATAJOLAB_WHATSAPP_E164 los CTA de la landing usan correo (no un wa.me vacío).
# ATAJOLAB_WHATSAPP_E164=54911XXXXXXXX
# ATAJOLAB_COMMERCIAL_EMAIL=atajolab.tools@gmail.com

# Backups y monitoreo (ver docs/backups.md y docs/monitoring.md)
BACKUP_RETENTION_DAYS=14
PG_DOCKER_NETWORK=
# Copia externa con rclone (obligatoria en producción): remoto y archivo de configuración (permisos 600)
OFFSITE_RCLONE_REMOTE=
RCLONE_CONFIG_FILE=
# Alertas: URL de ntfy/Slack/Discord. ALERT_WEBHOOK_FORMAT=text|json
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=text

# Compuerta comercial: con las ventas cerradas (por defecto) nadie puede iniciar un cobro aunque haya
# credenciales de Mercado Pago. SALES_ALLOWLIST habilita cuentas puntuales (compra real controlada);
# SALES_ENABLED=true abre las ventas al público (solo tras completar los requisitos legales).
SALES_ENABLED=false
SALES_ALLOWLIST=
