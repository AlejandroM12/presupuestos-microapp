# --- Base de datos (PostgreSQL dedicada a esta app) ---
DATABASE_URL="postgresql://presupuestos:change-me@localhost:5432/presupuestos?schema=public"

# --- App ---
APP_URL="http://localhost:3000"

# --- Autenticación (Auth.js) ---
# Generar con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# --- Pruebas de integración (opcional; sin esta variable se omiten) ---
TEST_DATABASE_URL=""

# Opcional: límite de registros por hora y por IP (por defecto 10)
# RATE_LIMIT_REGISTER_PER_HOUR=10
# Opcional: solicitudes de PDF por minuto y por IP (por defecto 20)
# RATE_LIMIT_PDF_PER_MINUTE=20

# --- Mercado Pago (sin estas variables los pagos quedan deshabilitados) ---
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# --- Email (Resend; sin estas variables no se envían correos) ---
RESEND_API_KEY=""
EMAIL_FROM="AtajoLab Presupuestos <presupuestos@atajolab.dev>"

# --- Tareas programadas (POST /api/cron/billing con "Authorization: Bearer <secreto>") ---
CRON_SECRET=""

# --- Precios (opcional; por defecto 9900 / 5900 / 59000 ARS) ---
# PRICE_PREMIUM_PACK_ARS=9900
# PRICE_PRO_MONTHLY_ARS=5900
# PRICE_PRO_YEARLY_ARS=59000
# Opcional: intentos de login por IP cada 15 min (por defecto 40)
# RATE_LIMIT_LOGIN_PER_IP=40

# --- Contacto comercial (plantillas a medida; no inventar el número) ---
# WhatsApp en E.164 (solo dígitos o con +). Sin este valor, los CTA usan correo.
# ATAJOLAB_WHATSAPP_E164=54911XXXXXXXX
# ATAJOLAB_COMMERCIAL_EMAIL=atajolab.tools@gmail.com

# Compuerta comercial (ver deploy/.env.production.example)
# SALES_ENABLED=false
# SALES_ALLOWLIST=
